{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elephant",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  // Cloudflare creates the DNS record and TLS certificate on deploy.
  // Do not pre-create an `elephant` record on the zone: deploy fails if one exists.
  "routes": [{ "pattern": "elephant.brcornelius.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }]
}
