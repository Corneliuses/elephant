{
  "name": "elephant",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A phones-in-a-circle drawing game. Named for the blind men and the elephant.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --project game --project web --coverage.enabled --coverage.provider=v8 --coverage.include='src/game/**' --coverage.include='web/src/lib/**/*.ts' --coverage.reporter=text",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "dev": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "check:web": "svelte-check --workspace web",
    "e2e": "node scripts/e2e.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.13.2",
    "playwright": "^1.62.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
